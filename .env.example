# --- Google Cloud -----------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Makes CrewAI's native Gemini provider and google-genai talk to Vertex AI (uses ADC).
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Models -----------------------------------------------------------------
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Backends: "gcp" (Vertex Vector Search + GCS/Firestore + Cloud Tasks) or "local"
STORAGE_BACKEND=local
VECTOR_BACKEND=local
EMBEDDING_BACKEND=local
JOB_BACKEND=local
LOCAL_DATA_DIR=.local

# --- GCP resources (filled in from `terraform output`) -----------------------
GCS_BUCKET=
VECTOR_INDEX_ID=
VECTOR_INDEX_ENDPOINT_ID=
VECTOR_DEPLOYED_INDEX_ID=research_crew_deployed
TASKS_QUEUE=research-crew-jobs
TASKS_SERVICE_ACCOUNT=
SERVICE_URL=
